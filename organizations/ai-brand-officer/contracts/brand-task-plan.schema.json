{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brand-task-plan.schema.json",
  "title": "AI Brand Officer Task Plan",
  "x-runtimeConstraints": [
    "selected-execute-correspondence",
    "selected-skipped-partition",
    "unique-upstream-artifact-version",
    "routing-reason-correspondence"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "enterpriseId",
    "businessProjectId",
    "skillId",
    "goal",
    "selectedModuleIds",
    "skippedModuleIds",
    "steps",
    "requiredEvidence",
    "upstreamArtifacts",
    "acceptanceCriteria",
    "stopConditions",
    "initialState",
    "routingReason",
    "planHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "taskId": {
      "$ref": "#/$defs/safeId"
    },
    "enterpriseId": {
      "$ref": "#/$defs/safeId"
    },
    "businessProjectId": {
      "$ref": "#/$defs/safeId"
    },
    "skillId": {
      "enum": [
        "brand-positioning",
        "brand-visual",
        "brand-communication"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "selectedModuleIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/moduleId"
      }
    },
    "skippedModuleIds": {
      "$ref": "#/$defs/moduleIds"
    },
    "steps": {
      "type": "array",
      "minItems": 7,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "enum": [
              "knowledge-preflight",
              "bind-upstream-artifacts",
              "collect-evidence",
              "rule-review",
              "professional-review",
              "debug-or-package"
            ]
          },
          {
            "type": "string",
            "pattern": "^execute:(?:category-positioning|audience-positioning|differentiation-positioning|mindshare-occupation|visual-identity-system|store-identity|poster-art-direction|product-packaging|ai-visual-generation|content-communication|brand-campaign|brand-story|founder-ip-communication)$"
          }
        ]
      },
      "oneOf": [
        {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            {
              "const": "knowledge-preflight"
            },
            {
              "const": "bind-upstream-artifacts"
            },
            {
              "const": "collect-evidence"
            },
            {
              "$ref": "#/$defs/executeStep"
            },
            {
              "const": "rule-review"
            },
            {
              "const": "professional-review"
            },
            {
              "const": "debug-or-package"
            }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "prefixItems": [
            {
              "const": "knowledge-preflight"
            },
            {
              "const": "bind-upstream-artifacts"
            },
            {
              "const": "collect-evidence"
            },
            {
              "$ref": "#/$defs/executeStep"
            },
            {
              "$ref": "#/$defs/executeStep"
            },
            {
              "const": "rule-review"
            },
            {
              "const": "professional-review"
            },
            {
              "const": "debug-or-package"
            }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "prefixItems": [
            {
              "const": "knowledge-preflight"
            },
            {
              "const": "bind-upstream-artifacts"
            },
            {
              "const": "collect-evidence"
            },
            {
              "$ref": "#/$defs/executeStep"
            },
            {
              "$ref": "#/$defs/executeStep"
            },
            {
              "$ref": "#/$defs/executeStep"
            },
            {
              "const": "rule-review"
            },
            {
              "const": "professional-review"
            },
            {
              "const": "debug-or-package"
            }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "prefixItems": [
            {
              "const": "knowledge-preflight"
            },
            {
              "const": "bind-upstream-artifacts"
            },
            {
              "const": "collect-evidence"
            },
            {
              "$ref": "#/$defs/executeStep"
            },
            {
              "$ref": "#/$defs/executeStep"
            },
            {
              "$ref": "#/$defs/executeStep"
            },
            {
              "$ref": "#/$defs/executeStep"
            },
            {
              "const": "rule-review"
            },
            {
              "const": "professional-review"
            },
            {
              "const": "debug-or-package"
            }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "prefixItems": [
            {
              "const": "knowledge-preflight"
            },
            {
              "const": "bind-upstream-artifacts"
            },
            {
              "const": "collect-evidence"
            },
            {
              "$ref": "#/$defs/executeStep"
            },
            {
              "$ref": "#/$defs/executeStep"
            },
            {
              "$ref": "#/$defs/executeStep"
            },
            {
              "$ref": "#/$defs/executeStep"
            },
            {
              "$ref": "#/$defs/executeStep"
            },
            {
              "const": "rule-review"
            },
            {
              "const": "professional-review"
            },
            {
              "const": "debug-or-package"
            }
          ],
          "items": false
        }
      ]
    },
    "requiredEvidence": {
      "type": "array",
      "minItems": 5,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidenceRequirement"
      }
    },
    "upstreamArtifacts": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 5,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "stopConditions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "initialState": {
      "enum": [
        "planning"
      ]
    },
    "routingReason": {
      "enum": [
        "explicit-modules",
        "goal-keyword-match",
        "full-skill-fallback"
      ]
    },
    "planHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "skillId"
        ],
        "properties": {
          "skillId": {
            "const": "brand-positioning"
          }
        }
      },
      "then": {
        "properties": {
          "selectedModuleIds": {
            "items": {
              "enum": [
                "category-positioning",
                "audience-positioning",
                "differentiation-positioning",
                "mindshare-occupation"
              ]
            }
          },
          "skippedModuleIds": {
            "items": {
              "enum": [
                "category-positioning",
                "audience-positioning",
                "differentiation-positioning",
                "mindshare-occupation"
              ]
            }
          },
          "steps": {
            "items": {
              "oneOf": [
                {
                  "enum": [
                    "knowledge-preflight",
                    "bind-upstream-artifacts",
                    "collect-evidence",
                    "rule-review",
                    "professional-review",
                    "debug-or-package"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^execute:(?:category-positioning|audience-positioning|differentiation-positioning|mindshare-occupation)$"
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "skillId"
        ],
        "properties": {
          "skillId": {
            "const": "brand-visual"
          }
        }
      },
      "then": {
        "properties": {
          "selectedModuleIds": {
            "items": {
              "enum": [
                "visual-identity-system",
                "store-identity",
                "poster-art-direction",
                "product-packaging",
                "ai-visual-generation"
              ]
            }
          },
          "skippedModuleIds": {
            "items": {
              "enum": [
                "visual-identity-system",
                "store-identity",
                "poster-art-direction",
                "product-packaging",
                "ai-visual-generation"
              ]
            }
          },
          "steps": {
            "items": {
              "oneOf": [
                {
                  "enum": [
                    "knowledge-preflight",
                    "bind-upstream-artifacts",
                    "collect-evidence",
                    "rule-review",
                    "professional-review",
                    "debug-or-package"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^execute:(?:visual-identity-system|store-identity|poster-art-direction|product-packaging|ai-visual-generation)$"
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "skillId"
        ],
        "properties": {
          "skillId": {
            "const": "brand-communication"
          }
        }
      },
      "then": {
        "properties": {
          "selectedModuleIds": {
            "items": {
              "enum": [
                "content-communication",
                "brand-campaign",
                "brand-story",
                "founder-ip-communication"
              ]
            }
          },
          "skippedModuleIds": {
            "items": {
              "enum": [
                "content-communication",
                "brand-campaign",
                "brand-story",
                "founder-ip-communication"
              ]
            }
          },
          "steps": {
            "items": {
              "oneOf": [
                {
                  "enum": [
                    "knowledge-preflight",
                    "bind-upstream-artifacts",
                    "collect-evidence",
                    "rule-review",
                    "professional-review",
                    "debug-or-package"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^execute:(?:content-communication|brand-campaign|brand-story|founder-ip-communication)$"
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "not": {
        "pattern": "^(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\..*)?$"
      },
      "allOf": [
        {
          "not": {
            "pattern": "[.]$"
          }
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "moduleId": {
      "enum": [
        "category-positioning",
        "audience-positioning",
        "differentiation-positioning",
        "mindshare-occupation",
        "visual-identity-system",
        "store-identity",
        "poster-art-direction",
        "product-packaging",
        "ai-visual-generation",
        "content-communication",
        "brand-campaign",
        "brand-story",
        "founder-ip-communication"
      ]
    },
    "moduleIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/moduleId"
      }
    },
    "executeStep": {
      "type": "string",
      "pattern": "^execute:(?:category-positioning|audience-positioning|differentiation-positioning|mindshare-occupation|visual-identity-system|store-identity|poster-art-direction|product-packaging|ai-visual-generation|content-communication|brand-campaign|brand-story|founder-ip-communication)$"
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementId",
        "category",
        "description",
        "mandatory"
      ],
      "properties": {
        "requirementId": {
          "$ref": "#/$defs/safeId"
        },
        "category": {
          "enum": [
            "upstream-artifact",
            "feishu",
            "conversation",
            "public-web",
            "professional-judgment",
            "inference",
            "assumption",
            "unknown"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "mandatory": {
          "type": "boolean"
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "version",
        "sha256",
        "sourceOrganizationId"
      ],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/safeId"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceOrganizationId": {
          "$ref": "#/$defs/safeId"
        }
      }
    }
  }
}
